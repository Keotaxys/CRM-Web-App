rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function approved() { return signedIn()
      && request.auth.token.accountStatus == 'approved'
      && profile().accountStatus == 'approved'
      && profile().role == request.auth.token.role
      && profile().branchId == request.auth.token.branchId; }
    function admin() { return approved() && request.auth.token.role == 'admin'; }
    function manager() { return approved() && request.auth.token.role == 'branch_manager'; }
    function staff() { return approved() && request.auth.token.role == 'staff'; }
    function sameBranch(data) { return approved() && data.branchId != null && data.branchId == request.auth.token.branchId; }
    function crmRead(data) { return admin() || sameBranch(data); }
    function ownSales(data) {
      return approved()
        && request.auth.token.role in ['staff', 'branch_manager']
        && data.staffUid == request.auth.uid;
    }
    function managerSales(data) {
      return manager() && data.branchId == request.auth.token.branchId;
    }
    function salesRead(data) {
      return admin() || ownSales(data) || managerSales(data);
    }
    function giftBranchRead(data) { return admin() || sameBranch(data); }
    function giftManagerRead(data) { return admin() || (manager() && sameBranch(data)); }
    function giftStaffRecord(data) { return staff() && data.createdBy == request.auth.uid; }
    function giftStaffMovement(data) { return staff() && data.distributionOwnerUid == request.auth.uid; }
    function giftDistributionRead(data) { return giftManagerRead(data) || giftStaffRecord(data); }
    function knownBranch(branchId) { return branchId in ['010','019','020','030','040','050','060','070','080','090','110','120','130','140','150','160','170','180','190','200','210','220']; }
    function validBirthDate(value) {
      return value == null
        || (value is string && value.matches('^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-[0-9]{4}$'));
    }
    function validCustomerImagePaths(customerId) {
      return (request.resource.data.get('imageStoragePath', null) == null || request.resource.data.imageStoragePath == 'customers/' + customerId + '/customer-photo')
        && (request.resource.data.get('placeImageStoragePath', null) == null || request.resource.data.placeImageStoragePath == 'customers/' + customerId + '/place-photo');
    }
    function validCustomerCreate(customerId) {
      return request.resource.data.keys().hasAll([
          'name','phone','address','status','priority','branchId','branch','note','gps','location',
          'imageUrl','placeImageUrl','imageStoragePath','placeImageStoragePath','statusTimestamps',
          'recordState','createdBy','createdAt','updatedBy','updatedAt','archivedBy','archivedAt','deletedBy','deletedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name','phone','address','status','priority','branchId','branch','note','gps','location',
          'birthDate','imageUrl','placeImageUrl','imageStoragePath','placeImageStoragePath','statusTimestamps',
          'recordState','createdBy','createdAt','updatedBy','updatedAt','archivedBy','archivedAt','deletedBy','deletedAt'
        ])
        && knownBranch(request.resource.data.branchId)
        && request.resource.data.status in ['ໃໝ່','ຕິດຕາມຕໍ່','ດຳເນີນການແລ້ວ','ຈັດສົ່ງແລ້ວ']
        && (!request.resource.data.keys().hasAll(['priority']) || request.resource.data.priority in ['ທົ່ວໄປ','ດ່ວນ','VIP'])
        && validBirthDate(request.resource.data.get('birthDate', null))
        && validCustomerImagePaths(customerId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.statusTimestamps[request.resource.data.status] == request.time
        && request.resource.data.recordState == 'active'
        && request.resource.data.archivedBy == null && request.resource.data.archivedAt == null
        && request.resource.data.deletedBy == null && request.resource.data.deletedAt == null;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin() || (approved() && resource.data.accountStatus == 'approved' && resource.data.branchId == request.auth.token.branchId));
      allow list: if admin() || (approved() && resource.data.accountStatus == 'approved' && resource.data.branchId == request.auth.token.branchId);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.accountStatus == 'pending'
        && request.resource.data.role == null
        && request.resource.data.branchId == null
        && request.resource.data.keys().hasOnly(['name','email','phone','photoURL','photoStoragePath','role','branchId','accountStatus','createdAt','updatedAt','approvedAt','approvedBy']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','photoURL','photoStoragePath','updatedAt']);
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if crmRead(resource.data);
      allow create: if approved() && validCustomerCreate(customerId)
        && (admin() || request.resource.data.branchId == request.auth.token.branchId);
      allow update: if crmRead(resource.data)
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['ໃໝ່','ຕິດຕາມຕໍ່','ດຳເນີນການແລ້ວ','ຈັດສົ່ງແລ້ວ']
        && (!request.resource.data.keys().hasAll(['priority']) || request.resource.data.priority in ['ທົ່ວໄປ','ດ່ວນ','VIP'])
        && validBirthDate(request.resource.data.get('birthDate', null))
        && validCustomerImagePaths(customerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','phone','address','status','priority','note','gps','location',
          'birthDate',
          'imageUrl','placeImageUrl','imageStoragePath','placeImageStoragePath','statusTimestamps',
          'updatedBy','updatedAt'
        ])
        && request.resource.data.recordState == resource.data.recordState;
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow read: if crmRead(resource.data);
      allow create, update, delete: if false;
    }

    match /branches/{branchId} {
      allow read: if approved();
      allow write: if false;
    }

    match /salesProducts/{productId} {
      allow read: if approved();
      allow create, update, delete: if false;
    }

    match /dailySales/{dailySalesId} {
      allow read: if salesRead(resource.data);
      allow create, update, delete: if false;

      match /revisions/{revisionId} {
        allow read: if salesRead(get(/databases/$(database)/documents/dailySales/$(dailySalesId)).data);
        allow create, update, delete: if false;
      }
    }

    match /giftItems/{giftId} {
      allow read: if admin() || manager() || (staff() && resource.data.active == true);
      allow create, update, delete: if false;
    }

    match /branchGiftStocks/{stockId} {
      allow read: if giftBranchRead(resource.data);
      allow create, update, delete: if false;
    }

    match /giftCampaigns/{campaignId} {
      allow read: if giftBranchRead(resource.data);
      allow create, update, delete: if false;
    }

    match /giftReceipts/{receiptId} {
      allow read: if giftManagerRead(resource.data);
      allow create, update, delete: if false;
    }

    match /giftAllocations/{allocationId} {
      allow read: if admin() || (manager()
        && resource.data.targetBranchId != null
        && resource.data.targetBranchId == request.auth.token.branchId);
      allow create, update, delete: if false;
    }

    match /giftDistributions/{distributionId} {
      allow read: if giftDistributionRead(resource.data);
      allow create, update, delete: if false;

      match /revisions/{revisionId} {
        allow read: if giftDistributionRead(get(/databases/$(database)/documents/giftDistributions/$(distributionId)).data);
        allow create, update, delete: if false;
      }
    }

    match /giftStockMovements/{movementId} {
      allow read: if giftManagerRead(resource.data) || giftStaffMovement(resource.data);
      allow create, update, delete: if false;
    }

    match /giftItemNameKeys/{nameKey} {
      allow read, write: if false;
    }

    match /giftCampaignNameKeys/{nameKey} {
      allow read, write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
